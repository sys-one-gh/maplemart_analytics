# Copy this file to .env (never commit .env) and change the password.
# Must satisfy SQL Server complexity rules: 8+ chars, upper+lower+digit+symbol.
SA_PASSWORD=ChangeMe!2026

# Used by Database/Security/11_CreateSecurity.sql for the Power BI read-only login
POWERBI_READER_PASSWORD=ChangeMePBI!2026

# Host-side ports. If 1433/11434 are already taken on your machine,
# scripts/setup.sh (or setup.ps1) auto-picks the next free port and
# rewrites these along with DB_SERVER/OLLAMA_HOST below - you don't need
# to set these by hand.
SQLSERVER_PORT=1433
OLLAMA_PORT=11434

DB_SERVER=localhost,1433
DB_NAME=CustomerCampaignAnalytics
DB_USER=sa

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral
